PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# Demo admin account for /admin — replace ADMIN_PASSWORD_HASH with your own bcrypt hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$replace-with-a-bcrypt-hash

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Deployed frontend origin (Vercel URL) — used for CORS
CLIENT_URL=http://localhost:5173
